<% content_for(:title, t('.title')) %>
<div class="max-w-2xl mx-auto mt-10 px-6 mb-10">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold"><%= t('.title') %></h1>
    <% if current_user.staff? %>
      <%= link_to new_material_path, class: "px-6 inline-flex items-center justify-center gap-2 text-white text-lg font-bold py-3 rounded-lg shadow-md bg-blue-600 hover:bg-blue-700 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200" do %>
        <%= t('.new') %>
      <% end %>
    <% end %>
  </div>

  <% if @materials.empty? %>
    <p class="text-lg text-gray-500"><%= t('.empty') %></p>
  <% else %>
    <div class="space-y-4">
      <% @materials.each do |material| %>
        <div class="border border-gray-300 rounded-lg px-6 py-5 bg-gray-50 flex items-center justify-between gap-4">
          <div class="min-w-0">
            <p class="text-xl font-bold truncate"><%= material.title %></p>
            <p class="text-base text-gray-600 mt-1 whitespace-pre-wrap"><%= material.description %></p>
          </div>
          <div class="shrink-0 flex items-center gap-3">
            <% if material.file.attached? %>
              <%= link_to t('.download'), rails_blob_path(material.file, disposition: "attachment"), class: "px-5 py-3 text-white text-lg font-bold rounded-lg shadow-md bg-blue-600 hover:bg-blue-700 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200" %>
            <% end %>
            <% if current_user.staff? %>
              <%= link_to material_path(material), id: "button-delete-#{material.id}", data: { turbo_method: :delete, turbo_confirm: t('materials.delete_confirm') } do %>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-7 text-gray-500 hover:text-gray-700 transition-colors">
                  <path fill-rule="evenodd" d="M16.5 4.478v.227a48.816 48.816 0 0 0-8.836 0 2.554 2.554 0 0 1-.302-.128 2.25 2.25 0 0 1 1.096-3.791 48.972 48.972 0 0 1 5.918 0 2.25 2.25 0 0 1 2.124 3.692ZM19.5 7.5a.75.75 0 0 1-.75.75H5.25a.75.75 0 0 1 0-1.5h13.5a.75.75 0 0 1 .75.75Z" clip-rule="evenodd" />
                  <path fill-rule="evenodd" d="M4.998 9.5a.75.75 0 0 1 .75-.75h12.504a.75.75 0 0 1 .75.75v8.5a3.75 3.75 0 0 1-3.75 3.75H8.748a3.75 3.75 0 0 1-3.75-3.75V9.5Z" clip-rule="evenodd" />
                </svg>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <%= link_to root_path, class: "mt-8 inline-flex items-center justify-center gap-2 w-full bg-gray-800 text-white text-xl font-bold py-4 rounded-lg shadow-md hover:bg-gray-700 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200" do %>
    ← <%= t('.return') %>
  <% end %>
</div>
