<% content_for(:title, t('.title')) %>
<div class="max-w-md mx-auto mt-10 px-6 mb-10">
  <%= form_with model: @material do |f| %>
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-2xl font-bold"><%= t('.title') %></h1>
      <%= f.submit class: "inline-flex items-center justify-center gap-2 bg-blue-600 text-white text-xl font-bold px-6 py-4 rounded-lg shadow-md hover:bg-blue-700 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200" %>
    </div>
    <%= render "shared/error_messages", object: f.object %>
    <div class="mb-4">
      <%= f.label :title, class: "block text-lg font-medium text-gray-700 mb-1" %>
      <%= f.text_field :title, class: "w-full border border-gray-300 rounded px-4 py-3 text-lg" %>
    </div>
    <div class="mb-4">
      <%= f.label :description, class: "block text-lg font-medium text-gray-700 mb-1" %>
      <%= f.text_area :description, rows: 4, class: "w-full border border-gray-300 rounded px-4 py-3 text-lg" %>
    </div>
    <div class="mb-6">
      <%= f.label :file, class: "block text-lg font-medium text-gray-700 mb-1" %>
      <%= f.file_field :file, class: "w-full border border-gray-300 rounded px-4 py-3 text-lg bg-white" %>
    </div>
    <%= link_to materials_path, class: "mt-6 inline-flex items-center justify-center gap-2 w-full bg-gray-800 text-white text-xl font-bold py-4 rounded-lg shadow-md hover:bg-gray-700 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200" do %>
    ← <%= t('.return') %>
    <% end %>
  <% end %>
</div>
