<% content_for(:title, t('.title')) %>
<div class="max-w-md mx-auto mt-10 px-6 mb-10">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold"><%= t('.title') %></h1>
    <div class="flex items-center gap-3">
      <%= link_to edit_schedule_path(@schedule), id: "button-edit-#{@schedule.id}" do %>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-7 text-gray-500 hover:text-gray-700 transition-colors">
          <path d="M21.731 2.269a2.625 2.625 0 0 0-3.712 0l-1.157 1.157 3.712 3.712 1.157-1.157a2.625 2.625 0 0 0 0-3.712ZM19.513 8.199l-3.712-3.712-12.15 12.15a5.25 5.25 0 0 0-1.32 2.214l-.8 2.685a.75.75 0 0 0 .933.933l2.685-.8a5.25 5.25 0 0 0 2.214-1.32l12.15-12.15Z" />
        </svg>
      <% end %>
      <%= link_to schedule_path(@schedule), id: "button-delete-#{@schedule.id}", data: { turbo_method: :delete, turbo_confirm: t('schedules.delete_confirm') } do %>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-7 text-gray-500 hover:text-gray-700 transition-colors">
          <path fill-rule="evenodd" d="M16.5 4.478v.227a48.816 48.816 0 0 0-8.836 0 2.554 2.554 0 0 1-.302-.128 2.25 2.25 0 0 1 1.096-3.791 48.972 48.972 0 0 1 5.918 0 2.25 2.25 0 0 1 2.124 3.692ZM19.5 7.5a.75.75 0 0 1-.75.75H5.25a.75.75 0 0 1 0-1.5h13.5a.75.75 0 0 1 .75.75Z" clip-rule="evenodd" />
          <path fill-rule="evenodd" d="M4.998 9.5a.75.75 0 0 1 .75-.75h12.504a.75.75 0 0 1 .75.75v8.5a3.75 3.75 0 0 1-3.75 3.75H8.748a3.75 3.75 0 0 1-3.75-3.75V9.5Z" clip-rule="evenodd" />
        </svg>
      <% end %>
    </div>
  </div>

  <div class="mb-4">
    <%= label_tag nil, Schedule.human_attribute_name(:title), class: "block text-lg font-medium text-gray-700 mb-1" %>
    <p class="w-full border border-gray-300 rounded px-4 py-3 text-lg bg-gray-50"><%= @schedule.title %></p>
  </div>

  <div class="mb-4">
    <%= label_tag nil, Schedule.human_attribute_name(:start_time), class: "block text-lg font-medium text-gray-700 mb-1" %>
    <p class="w-full border border-gray-300 rounded px-4 py-3 text-lg bg-gray-50"><%= l(@schedule.start_time, format: :long) if @schedule.start_time %></p>
  </div>

  <div class="mb-4">
    <%= label_tag nil, Schedule.human_attribute_name(:end_time), class: "block text-lg font-medium text-gray-700 mb-1" %>
    <p class="w-full border border-gray-300 rounded px-4 py-3 text-lg bg-gray-50"><%= l(@schedule.end_time, format: :long) if @schedule.end_time %></p>
  </div>

  <div class="mb-4">
    <%= label_tag nil, Schedule.human_attribute_name(:location), class: "block text-lg font-medium text-gray-700 mb-1" %>
    <p class="w-full border border-gray-300 rounded px-4 py-3 text-lg bg-gray-50"><%= @schedule.location %></p>
  </div>

  <div class="mb-6">
    <%= label_tag nil, Schedule.human_attribute_name(:description), class: "block text-lg font-medium text-gray-700 mb-1" %>
    <div class="w-full border border-gray-300 rounded px-4 py-3 text-lg bg-gray-50 whitespace-pre-wrap"><%= @schedule.description %></div>
  </div>

  <%= link_to root_path, class: "mt-6 inline-flex items-center justify-center gap-2 w-full bg-gray-800 text-white text-xl font-bold py-4 rounded-lg shadow-md hover:bg-gray-700 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200" do %>
  ← <%= t('.return') %>
  <% end %>

</div>
